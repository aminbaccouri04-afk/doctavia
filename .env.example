# Doctavia Server - Environment Template

# Server
PORT=5000
NODE_ENV=development

# Database (MySQL/MariaDB)
DB_HOST=127.0.0.1
DB_USER=doctavia_user
DB_PASSWORD=secure_password
DB_NAME=doctavia_db
DB_PORT=3306
DB_DIALECT=mysql

# Security (JWT)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Optional encryption key (exactly 32 characters)
ENCRYPTION_KEY=replace-with-32-character-key!!

# OpenRouter
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
